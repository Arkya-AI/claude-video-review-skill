# Bring your own keys. Copy this file to .env in the skill folder and fill in your own keys.
# The skill never sends your keys anywhere except the provider they belong to.

# Required: Gemini watches the video with its sound. Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Recommended: Jev by TypeSafe checks every frame. Create a key at https://console.typesafe.ai
TYPESAFE_API_KEY=

# GPT reviews still frames through the Codex CLI, which uses your own OpenAI sign-in (run: codex login).
